{
  "name": "juying-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "build": {
    "appId": "org.juying.app",
    "productName": "聚影",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [
      {
        "from": "server-bundle",
        "to": "server"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "聚影",
      "artifactName": "聚影-安装版-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
